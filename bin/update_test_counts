#!/bin/bash
# docs/test-strategy.md の「テストの厚み配分」のケース数を実測から自動生成する
#
# 使い方:
#   bin/update_test_counts          # 表を実測値で書き換える
#   bin/update_test_counts --check  # 表が実測値と一致するか検証する（CI・フック用）
set -euo pipefail
cd "$(dirname "$0")/.."

DOC=docs/test-strategy.md
START="<!-- test-counts:start -->"
END="<!-- test-counts:end -->"

rspec_count() { cat "$@" | grep -cE '^\s*it\b'; }
e2e_count()   { cat "$@" | grep -cF 'test('; }

model_total=$(rspec_count spec/models/*_spec.rb)
request_total=$(rspec_count spec/requests/*_spec.rb spec/requests/api/v1/*_spec.rb)
e2e_total=$(e2e_count e2e/*.spec.ts)

game=$(rspec_count spec/models/game_spec.rb)
rounds_mpa=$(rspec_count spec/requests/rounds_spec.rb)
rounds_api=$(rspec_count spec/requests/api/v1/rounds_spec.rb)
games_mpa=$(rspec_count spec/requests/games_spec.rb)
games_api=$(rspec_count spec/requests/api/v1/games_spec.rb)
score_input=$(e2e_count e2e/score_input.spec.ts)
home=$(e2e_count e2e/home.spec.ts)

player=$(rspec_count spec/models/player_spec.rb)
round=$(rspec_count spec/models/round_spec.rb)
score=$(rspec_count spec/models/score_spec.rb)
if [ "$player" = "$round" ] && [ "$round" = "$score" ]; then
  periphery="各${player}"
else
  periphery="${player} / ${round} / ${score}"
fi

block=$(cat <<EOF
${START}
### レイヤーごとの役割

| レイヤー | ツール | ケース数 | 守るもの | 例え |
|---|---|---|---|---|
| E2E（End-to-End） | Playwright | ${e2e_total} | JS挙動・ユーザー操作フロー | お客さんの席を守る門番 |
| リクエストスペック | RSpec | ${request_total} | HTTP入出力・バリデーション | 注文の受け渡しを守る門番 |
| モデルスペック | RSpec | ${model_total} | 計算ロジック・不変条件 | 厨房の裏側を守る門番 |

### 対象ごとの配分

| 対象 | テスト | ケース数 |
|---|---|---|
| 急所①② 計算・不変条件 | \`spec/models/game_spec.rb\` | ${game} |
| 急所③ 点数入力（MPA / API） | \`spec/requests/**/rounds_spec.rb\` | ${rounds_mpa} + ${rounds_api} |
| 急所③ の JS 挙動 | \`e2e/score_input.spec.ts\` | ${score_input} |
| ゲーム作成・一覧（MPA / API） | \`spec/requests/**/games_spec.rb\` | ${games_mpa} + ${games_api} |
| 周辺モデル（Player / Round / Score） | 各モデルスペック | ${periphery} |
| トップページ（スモーク） | \`e2e/home.spec.ts\` | ${home} |
${END}
EOF
)

if ! grep -qF "$START" "$DOC"; then
  echo "エラー: ${DOC} にマーカー ${START} が見つかりません" >&2
  exit 1
fi

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

awk -v start="$START" -v end="$END" -v block="$block" '
  $0 == start { print block; skip = 1; next }
  $0 == end   { skip = 0; next }
  !skip       { print }
' "$DOC" > "$tmp"

if [ "${1:-}" = "--check" ]; then
  if diff -q "$DOC" "$tmp" > /dev/null; then
    echo "OK: ${DOC} のケース数は実測値と一致しています"
  else
    echo "NG: ${DOC} のケース数が実測値とズレています。bin/update_test_counts を実行してください" >&2
    diff "$DOC" "$tmp" >&2 || true
    exit 1
  fi
else
  cp "$tmp" "$DOC"
  echo "更新しました: ${DOC}"
fi
