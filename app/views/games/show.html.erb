<div class="games-show">
  <h1>スコア一覧</h1>

  <table class="score-table">
    <thead>
      <tr>
        <th></th>
        <% @players.each do |player| %>
          <th><%= player.name %></th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% (1..10).each do |num| %>
        <% round = @rounds.find { |r| r.round_number == num } %>
        <tr>
          <td><%= link_to num, new_game_round_path(@game, round_number: num) %></td>
          <% @players.each do |player| %>
            <% if round && @ranking_scores[round.id]
                 score = @ranking_scores[round.id][player.id]&.dig(:score)
               end %>
            <td class="<%= 'negative' if score && score < 0 %>">
              <%= score ? sprintf('%.1f', score) : '' %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td>合計</td>
        <% @players.each do |player| %>
          <% total = @ranking_scores.values.sum { |rs| rs[player.id]&.dig(:score).to_f } %>
          <td class="<%= 'negative' if total < 0 %>">
            <%= sprintf('%.1f', total) %>
          </td>
        <% end %>
      </tr>
    </tfoot>
  </table>

  <div class="back-link">
    <%= link_to "← トップに戻る", root_path %>
  </div>
</div>
