{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Rails (Docker Compose)",
      "runtimeExecutable": "docker",
      "runtimeArgs": [
        "compose",
        "up"
      ],
      "port": 3000
    },
    {
      "name": "LIFF (Next.js dev)",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 3001
    }
  ]
}